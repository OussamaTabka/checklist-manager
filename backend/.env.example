APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

# AI Test Agent Configuration
TEST_AGENT_URL=http://localhost:8000
VITE_TEST_AGENT_URL=http://localhost:8000
VITE_APP_URL=http://localhost:8000
# VITE_TEST_AGENT_WEBHOOK_URL=http://localhost/api/test-results
# VITE_TEST_AGENT_POLL_INTERVAL_MS=2000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=checklist_manager
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

INVITATION_EXPIRES_HOURS=24

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==================================================
# TEST CASE GENERATION - Free & Open Source Tools
# ==================================================

# Choose your test generation provider:
# Options: 'local-llm' (recommended), 'evomaster', 'fallback'
TEST_GENERATION_PROVIDER=local-llm

# Local LLM Configuration (Ollama, LM Studio)
# Ollama models: mistral, llama2, neural-chat, starling, etc.
# Get started: https://ollama.ai
LLM_API_URL=http://localhost:11434
LLM_MODEL=mistral

# EvoMaster Configuration (for API testing)
# Get started: https://github.com/WebCheckingCode/EvoMaster
EVOMASTER_URL=http://localhost
EVOMASTER_PORT=40898

# Legacy: Arxis API (optional, not needed with local tools)
ARXIS_BASE_URL=https://api.arxis.io/v1
ARXIS_API_KEY=


