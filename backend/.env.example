APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

# AI Test Agent Configuration
TEST_AGENT_URL=http://localhost:8000
VITE_TEST_AGENT_URL=http://localhost:8000
VITE_APP_URL=http://localhost:8000
# VITE_TEST_AGENT_WEBHOOK_URL=http://localhost/api/test-results
# VITE_TEST_AGENT_POLL_INTERVAL_MS=2000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=checklist_manager
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login@example.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_FROM_ADDRESS=your-verified-sender@example.com
MAIL_FROM_NAME="IntelliTest"

INVITATION_EXPIRES_HOURS=24

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==================================================
# TEST CASE GENERATION - Free & Open Source Tools
# ==================================================

# Choose your test generation provider:
# Options: 'local-llm' (recommended), 'evomaster', 'fallback'
TEST_GENERATION_PROVIDER=local-llm

# Local LLM Configuration (Ollama, LM Studio)
# Ollama models: mistral, llama2, neural-chat, starling, etc.
# Get started: https://ollama.ai
LLM_API_URL=http://localhost:11434
LLM_MODEL=mistral

# EvoMaster Configuration (for API testing)
# Get started: https://github.com/WebCheckingCode/EvoMaster
EVOMASTER_URL=http://localhost
EVOMASTER_PORT=40898

# Legacy: Arxis API (optional, not needed with local tools)
ARXIS_BASE_URL=https://api.arxis.io/v1
ARXIS_API_KEY=

# ==================================================
# FLAN-T5 + PLAYWRIGHT AGENTS PIPELINE
# ==================================================
SCENARIO_CLASSIFIER_ENABLED=true
SCENARIO_CLASSIFIER_PROVIDER=flan_t5
SCENARIO_CLASSIFIER_MODEL_NAME=google/flan-t5-small
SCENARIO_CLASSIFIER_MODEL_DIR=playwright-orchestrator/ml/scenario-classifier/models/runspec-scenario-classifier-best-ml-v2
SCENARIO_CLASSIFIER_TIMEOUT_MS=20000
SCENARIO_CLASSIFIER_MIN_CONFIDENCE=0.60
CLASSIFIER_FALLBACK_ENABLED=false

PLAYWRIGHT_AGENTS_ENABLED=true
PLAYWRIGHT_AGENTS_MODE=flan_t5_playwright_agents
PLAYWRIGHT_AGENTS_LOOP=vscode
PLAYWRIGHT_AGENTS_TIMEOUT_MS=180000
PLAYWRIGHT_AGENTS_WORKDIR=storage/app/agent-runs
PLAYWRIGHT_AGENTS_EXECUTE_GENERATED_TEST=true
PLAYWRIGHT_AGENTS_HEALER_ENABLED=true
PLAYWRIGHT_AGENTS_ALLOW_DETERMINISTIC_FALLBACK=false

# Playwright agent LLM provider (run_spec generation)
# Options: gemini, claude, openai (or codex alias)
LLM_PROVIDER=openai

# Codex/OpenAI credentials for Playwright agent (set one key at least)
AGENT_CODEX_API_KEY=
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_API_URL=https://api.openai.com/v1
AGENT_OPENAI_MODEL=gpt-5-codex
AGENT_OPENAI_MAX_TOKENS=4000
AGENT_OPENAI_TIMEOUT_MS=30000
AGENT_OPENAI_MAX_RETRIES=2

# Optional shared variable fallbacks
CODEX_API_KEY=
OPENAI_API_KEY=
