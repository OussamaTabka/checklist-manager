{
  "schema_version": "1.0",
  "run_id": "strict-fix-live-smoke",
  "target": { "base_url": "https://www.apple.com/tn/buy" },
  "runtime": {
    "headless": true,
    "timeout_ms": 30000,
    "viewport": { "width": 1280, "height": 720 },
    "trace": "off",
    "video": "off",
    "screenshot": "off"
  },
  "cases": [
    {
      "external_id": 999,
      "title": "Strict fallback smoke",
      "severity": "major",
      "use_auth": false,
      "steps": [
        { "action": "goto", "url": "https://www.apple.com/tn/buy" },
        {
          "action": "wait_for_selector",
          "selector": { "by": "css", "value": "button, [role=\"button\"], input[type=\"button\"], input[type=\"submit\"], a[role=\"button\"]" },
          "state": "visible",
          "timeout_ms": 20000
        },
        { "action": "click", "selector": { "by": "css", "value": "button, [role=\"button\"], input[type=\"button\"], input[type=\"submit\"], a[role=\"button\"]" } }
      ],
      "asserts": [
        { "type": "expect_visible", "selector": { "by": "css", "value": "button, [role=\"button\"], input[type=\"button\"], input[type=\"submit\"], a[role=\"button\"]" } }
      ]
    }
  ]
}
