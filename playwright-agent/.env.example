LLM_PROVIDER=gemini

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
CLAUDE_MAX_TOKENS=4000
CLAUDE_TIMEOUT_MS=30000
CLAUDE_MAX_RETRIES=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# OpenAI / Codex
# Set LLM_PROVIDER=openai (or codex) to use these values.
AGENT_CODEX_API_KEY=
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_API_URL=https://api.openai.com/v1
AGENT_OPENAI_MODEL=gpt-5-codex
AGENT_OPENAI_MAX_TOKENS=4000
AGENT_OPENAI_TIMEOUT_MS=30000
AGENT_OPENAI_MAX_RETRIES=2

# Optional shared variable fallbacks:
CODEX_API_KEY=
OPENAI_API_KEY=

RUN_HEADLESS=false
RUN_SLOW_MO_MS=700
RUN_HOLD_OPEN_MS=12000

ORCHESTRATOR_DIR=../playwright-orchestrator
TARGET_BASE_URL=http://host.docker.internal:5173
