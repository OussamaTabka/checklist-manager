# ===================================================
# TEST AGENT CONFIGURATION
# ===================================================
# Add these lines to your .env file (top level of project)

# Development Environment
VITE_TEST_AGENT_URL=http://localhost:8000
VITE_APP_URL=http://localhost:8000

# Production Environment (uncomment and update when deploying)
# VITE_TEST_AGENT_URL=https://test-agent.yourdomain.com
# VITE_APP_URL=https://yourdomain.com

# ===================================================
# IMPORTANT NOTES:
# ===================================================
# 1. DO NOT use quotes around values in .env
# 2. Laravel Vite handles the quote marks automatically
# 3. VITE_ prefix makes variables accessible in Vue
# 4. Restart your dev server after changes: npm run dev
# 5. Make sure test agent is running: docker-compose up
# ===================================================
