# Core (aliases supported: APP_BASE_URL, RUNNER_IMAGE, RUNS_DIR, LARAVEL_API_BASE_URL)
BASE_URL=http://host.docker.internal:5173
APP_BASE_URL=
TARGET_APP=checklist-manager
RUN_SUITE=smoke
RUN_MODE=smoke
SMOKE_PAGES=dashboard,checklists,projects
RUNS_ROOT=./runs
RUNS_DIR=
RUN_ID=

# Login smoke selectors (required for generated smoke case)
LOGIN_EMAIL_TESTID=login-input-email
LOGIN_PASSWORD_TESTID=login-input-password
LOGIN_SUBMIT_TESTID=login-btn-submit
DASHBOARD_URL_FRAGMENT=/dashboard
SMOKE_EXTERNAL_ID=7101
SMOKE_UI_LOGIN_EXTERNAL_ID=7102

# Auth strategy
AUTH_MODE=api
AUTH_UI_TEST_ENABLED=true
SANCTUM_CSRF_COOKIE_PATH=/sanctum/csrf-cookie
LOGIN_PATH=/api/login
AUTH_VERIFY_PATH=/api/me
AUTH_BODY_FORMAT=json
ENABLE_LOGIN_FLOW=true

# Note: when AUTH_MODE=api and SMOKE_PAGES contains protected pages,
# orchestrator forces ENABLE_LOGIN_FLOW=true automatically.

# Runtime defaults
RUNTIME_TIMEOUT_MS=30000
RUNTIME_VIEWPORT_WIDTH=1280
RUNTIME_VIEWPORT_HEIGHT=720
RUNTIME_HEADLESS=true
RUNTIME_TRACE=retain-on-failure
RUNTIME_VIDEO=retain-on-failure
RUNTIME_SCREENSHOT=only-on-failure

# Runner secrets (consumed by runner interpolation)
E2E_EMAIL=tester@example.com
E2E_PASSWORD=change-me

# Docker
DOCKER_IMAGE=checklist-playwright-job
RUNNER_IMAGE=
DOCKER_USE_HOST_GATEWAY=
DOCKER_EXTRA_ARGS=

# Laravel integration
ENABLE_LARAVEL=true
ENABLE_CREATE_RUN=true
ENABLE_PUBLISH_RESULTS=true
ENABLE_BATCH_RESULTS=true
ENABLE_FALLBACK_PATCH=true
LARAVEL_BASE_URL=http://localhost:8000/api
LARAVEL_API_BASE_URL=
LARAVEL_TOKEN=
PROJECT_VERSION_ID=
