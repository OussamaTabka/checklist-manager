# Core
BASE_URL=http://host.docker.internal:5173
APP_BASE_URL=http://host.docker.internal:5173
RUN_SUITE=smoke
RUN_MODE=smoke
RUNS_ROOT=./runs
RUNS_DIR=./runs
RUN_ID=

# Login smoke selectors
LOGIN_EMAIL_TESTID=auth-login-email-input
LOGIN_PASSWORD_TESTID=auth-login-password-input
LOGIN_SUBMIT_TESTID=auth-login-submit-btn
DASHBOARD_URL_FRAGMENT=/dashboard
SMOKE_EXTERNAL_ID=7101
ENABLE_LOGIN_FLOW=true

# Runtime defaults
RUNTIME_TIMEOUT_MS=30000
RUNTIME_VIEWPORT_WIDTH=1280
RUNTIME_VIEWPORT_HEIGHT=720
RUNTIME_HEADLESS=true
RUNTIME_TRACE=retain-on-failure
RUNTIME_VIDEO=retain-on-failure
RUNTIME_SCREENSHOT=only-on-failure

# Runner secrets
E2E_EMAIL=tester@example.com
E2E_PASSWORD=change-me

# Docker
DOCKER_IMAGE=checklist-playwright-job
RUNNER_IMAGE=checklist-playwright-job
DOCKER_USE_HOST_GATEWAY=
DOCKER_EXTRA_ARGS=

# Laravel integration
# Set to true after you provide LARAVEL_TOKEN + PROJECT_VERSION_ID
ENABLE_LARAVEL=false
ENABLE_CREATE_RUN=false
ENABLE_PUBLISH_RESULTS=false
ENABLE_BATCH_RESULTS=true
ENABLE_FALLBACK_PATCH=true
LARAVEL_BASE_URL=http://localhost:8000/api
LARAVEL_API_BASE_URL=http://localhost:8000/api
LARAVEL_TOKEN=
PROJECT_VERSION_ID=
