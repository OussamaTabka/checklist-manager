# Minimum requested aliases
APP_BASE_URL=http://host.docker.internal:5173
RUNNER_IMAGE=checklist-playwright-job
RUNS_DIR=../runs
LARAVEL_API_BASE_URL=http://localhost:8000/api
LARAVEL_TOKEN=26|RAC8nrLT09qT1uTt4db8pkwF37Flj15NJwPRtyeQc30f485b
TARGET_APP=checklist-manager

# Required execution context
RUN_SUITE=smoke
RUN_MODE=smoke
PROJECT_VERSION_ID=1
SMOKE_EXTERNAL_ID=1
SMOKE_UI_LOGIN_EXTERNAL_ID=2
ENABLE_LOGIN_FLOW=true

# Auth strategy
AUTH_MODE=api
AUTH_UI_TEST_ENABLED=true
SANCTUM_CSRF_COOKIE_PATH=http://host.docker.internal:8000/sanctum/csrf-cookie
LOGIN_PATH=http://host.docker.internal:8000/api/login
AUTH_VERIFY_PATH=http://host.docker.internal:8000/api/me
AUTH_BODY_FORMAT=json

# Login for smoke
E2E_EMAIL=chef@test.com
E2E_PASSWORD=password123

# Login selectors (testid-only)
LOGIN_EMAIL_TESTID=login-input-email
LOGIN_PASSWORD_TESTID=login-input-password
LOGIN_SUBMIT_TESTID=login-btn-submit
DASHBOARD_URL_FRAGMENT=/dashboard

# Runtime
RUNTIME_HEADLESS=true
RUNTIME_TIMEOUT_MS=30000
RUNTIME_VIEWPORT_WIDTH=1280
RUNTIME_VIEWPORT_HEIGHT=720
RUNTIME_TRACE=retain-on-failure
RUNTIME_VIDEO=retain-on-failure
RUNTIME_SCREENSHOT=only-on-failure

# Laravel integration
ENABLE_LARAVEL=true
ENABLE_CREATE_RUN=true
ENABLE_PUBLISH_RESULTS=true
ENABLE_BATCH_RESULTS=true
ENABLE_FALLBACK_PATCH=true
