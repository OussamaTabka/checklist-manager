{
    "schema_version": "1.0",
    "run_id": "ffa900c1-5529-4fd4-8f51-c0fe28262c1a",
    "target": {
        "base_url": "https://www.apple.com/tn/buy"
    },
    "runtime": {
        "headless": false,
        "slow_mo_ms": 700,
        "hold_open_ms": 12000,
        "timeout_ms": 30000,
        "viewport": {
            "width": 1280,
            "height": 720
        },
        "trace": "retain-on-failure",
        "video": "retain-on-failure",
        "screenshot": "only-on-failure"
    },
    "cases": [
        {
            "external_id": 45,
            "title": "Navigation Testing",
            "severity": "critical",
            "use_auth": true,
            "steps": [
                {
                    "action": "goto",
                    "url": "https://www.apple.com/tn/buy"
                },
                {
                    "action": "wait_for_selector",
                    "selector": {
                        "by": "css",
                        "value": "nav a[href], header a[href], a[href]"
                    },
                    "state": "visible",
                    "timeout_ms": 20000
                },
                {
                    "action": "click",
                    "selector": {
                        "by": "css",
                        "value": "nav a[href], header a[href], a[href]"
                    }
                },
                {
                    "action": "screenshot",
                    "name": "navigation-after-click"
                }
            ],
            "asserts": [
                {
                    "type": "expect_url_contains",
                    "value": "www.apple.com"
                }
            ]
        }
    ]
}
